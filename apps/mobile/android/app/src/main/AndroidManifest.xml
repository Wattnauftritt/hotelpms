<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keine Sicherung der App-Daten: darin liegt die Sitzung (verschluesselt,
         der Schluessel bleibt im Keystore), und nach einer Wiederherstellung auf
         einem anderen Telefon soll sich der Benutzer neu anmelden. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Benachrichtigungen der Personal-App (Migration 0193). Das Symbol
             in der Statusleiste muss einfarbig sein; das bunte App-Symbol
             zeichnet Android dort als weisses Quadrat. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_staygrid" />
        <!-- Kein Firebase Analytics: StayGrid zaehlt nicht, wer die App wie
             benutzt, und die Angaben im Store sagen das so. -->
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ab Android 13 fragt die App vor der ersten Benachrichtigung. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
