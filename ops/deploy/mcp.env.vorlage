# /opt/hotelpms/shared/mcp.env -- die ganze Umgebung des Claude-Zugangs
# (Dokument 38). Eigentuemer root, Modus 600: systemd liest sie als root,
# der Dienst selbst laeuft als fluechtiger Benutzer und sieht die Datei nie.
#
# Bewusst klein. Keine Verbindung der Anwendungsrolle, kein Geheimnis der
# API: der Zugang hat nur die Rolle hotelpms_mcp, und die sieht nur die
# geschwaerzten Sichten.

# 1 schaltet den Zugang ein. Alles andere laesst den Dienst sofort enden.
MCP_ENABLED=0

# Die Rolle aus scripts/setup-db.sh (HOTELPMS_DB_MCP_PASSWORD). Ueber den
# Unix-Socket von PostgreSQL, direkt und nicht ueber PgBouncer (Dokument 21 §6).
MCP_DATABASE_URL=postgres://hotelpms_mcp:KENNWORT@/hotelpms

# Dieselbe Adresse wie PUBLIC_APP_URL der API; daraus entstehen die
# Metadaten, die claude.ai beim Verbinden liest.
PUBLIC_APP_URL=https://app.staygrid.cloud

# Nur lokal; Caddy reicht /mcp weiter.
MCP_PORT=3100
LOG_LEVEL=info
