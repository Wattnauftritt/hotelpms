# Datenbank. Die API verbindet ueber PgBouncer, der Worker direkt (D1 in Dokument 13).
DATABASE_URL=postgres://hotelpms_app:devapp@127.0.0.1:5432/hotelpms_dev
DATABASE_URL_DIRECT=postgres://hotelpms_app:devapp@127.0.0.1:5432/hotelpms_dev
DATABASE_URL_OWNER=postgres://hotelpms_owner:devowner@127.0.0.1:5432/hotelpms_dev

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
# LISTEN_SOCKET=/run/hotelpms/api.sock

# Mindestens 32 Zeichen. Kein stiller Standardwert, der Start bricht sonst ab.
SESSION_SECRET=entwicklung-nur-bitte-in-produktion-ersetzen-0001
ID_DOCUMENT_KEY=entwicklung-nur-bitte-in-produktion-ersetzen-0002

# Ratenbegrenzung. Bewusst hoch: ein Haus hat mehrere Arbeitsplaetze hinter
# einer oeffentlichen Adresse, und aus dem eigenen System ausgesperrt zu sein
# ist ein groesserer Schaden als ein langsames Durchprobieren (C7).
# RATE_LIMIT_LOGIN=60
# RATE_LIMIT_ANON=300

# Nur waehrend einer Schluesselrotation gesetzt, siehe docs/17-betrieb.md.
# Beide Schluessel muessen gleichzeitig bekannt sein: der alte zum Lesen,
# der neue zum Schreiben.
# ID_DOCUMENT_KEY_OLD=
# ID_DOCUMENT_KEY_VERSION=2

# Ziel fuer Erfolgs- und Abbruchseite nach Pay-by-Link, und die Wurzel der
# Links in Einladung und Kennwortruecksetzung. Keine geheime Angabe -- aber
# wenn sie falsch steht, zeigen die Zugangslinks ins Leere.
PUBLIC_APP_URL=http://localhost:5173

# Netze, in die ein Webhook trotz Sperrliste zugestellt werden darf.
#
# Leer lassen. Ein Webhook-Ziel ist eine Adresse, die WIR von innen
# ansprechen, und der Worker steht neben Datenbank und API: ohne Sperrliste
# reicht `https://169.254.169.254/latest/meta-data/`, um sich die Zugangsdaten
# des Hosters zustellen zu lassen (Befund B1).
#
# Gefuellt wird das nur in einer selbst betriebenen Installation, die ein
# System im eigenen Netz beliefert -- und dann so eng wie moeglich, das
# einzelne Netz, nicht 10.0.0.0/8. Nur in ein hier eingetragenes Netz ist
# auch `http://` erlaubt, und dann als Adresse, nicht als Name; ins offene
# Netz geht nichts ohne TLS. Ein Tippfehler haelt API und Worker beim Start
# an, statt still zu wirken.
# WEBHOOK_ALLOWED_PRIVATE_CIDRS=10.0.1.0/24,192.168.7.5/32

# Payment-Adapter (Aufgabe 6). Optional: ohne diese beiden meldet die
# betroffene Route 503, der Rest des Systems laeuft unveraendert.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Mailversand ueber die REST-API von Brevo (nicht SMTP). Optional: ohne
# Schluessel bleibt eingereihte Gastpost in der Warteschlange stehen und geht
# hinaus, sobald er da ist.
#
# Derselbe Schluessel meldet auch die Absenderdomains der Haeuser an. Das
# Hotel braucht dafuer keinen Zugang zu diesem Konto: wir melden seine Domain
# damit an, es traegt die drei TXT-Eintraege bei seinem **eigenen**
# DNS-Anbieter ein.
# BREVO_API_KEY=xkeysib-...

# Postfach fuer Hinweise an uns selbst, heute nur: es liegt ein Antrag auf
# eine Absenderdomain im Adminpanel. Ein Postfach und keine Personenliste --
# wer ausscheidet, muesste sonst aus einer Liste im Code entfernt werden, und
# das geschieht nie.
# PLATFORM_NOTICE_EMAIL=info@staygrid.cloud

# Unterdomain fuer Haeuser ohne eigene Domain (GMX, Web.de, T-Online). Solche
# Adressen lassen sich nicht anmelden, und das ist richtig so: wer es
# koennte, koennte im Namen jedes GMX-Kunden schreiben. Diese Haeuser senden
# als <name>@mail.staygrid.cloud mit ihrem Hotelnamen davor und ihrer echten
# Adresse als Antwortadresse.
#
# **Einmal bei Brevo zu hinterlegen**, danach nie wieder. Steht sie dort
# nicht, faellt jede Mail dieser Haeuser durch die Pruefung beim Empfaenger.
# RELAY_EMAIL_DOMAIN=mail.staygrid.cloud

# Absender der Zugangspost: Einladung und Kennwortruecksetzung. Getrennt vom
# Absender je Haus, weil diese Nachrichten zu einem **Benutzer** gehoeren und
# nicht zu einem Haus -- er kann in mehreren arbeiten oder, beim Onboarding,
# noch in keinem.
#
# Ohne PLATFORM_EMAIL_FROM bleibt diese Post liegen, statt unter einem
# erfundenen Absender hinauszugehen: eine Einladung von noreply@localhost
# landet im Spam, und das faellt niemandem auf -- der Eingeladene wartet, und
# wir sehen eine Nachricht, die der Anbieter angenommen hat. Die Adresse muss
# bei Brevo verifiziert sein.
# PLATFORM_EMAIL_FROM=mail@staygrid.cloud
# PLATFORM_EMAIL_FROM_NAME=StayGrid
#
# PLATFORM_EMAIL_REPLY_TO nur setzen, wenn Antworten woanders hin sollen als
# an den Absender. Dieselbe Adresse hier einzutragen aendert nichts -- ohne
# Reply-To antwortet jedes Mailprogramm ohnehin an den Absender -- und eine
# zweite Stelle, an der dieselbe Adresse steht, laeuft beim naechsten Wechsel
# auseinander.
# PLATFORM_EMAIL_REPLY_TO=
