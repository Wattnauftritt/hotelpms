[Unit]
Description=hotelpms API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=hotelpms
Group=hotelpms
WorkingDirectory=/opt/hotelpms/current
EnvironmentFile=/opt/hotelpms/shared/env
Environment=NODE_ENV=production
Environment=LISTEN_SOCKET=/run/hotelpms/api.sock
ExecStart=/usr/bin/node /opt/hotelpms/current/apps/api/dist/server.js
Restart=always
RestartSec=2
# Legt /run/hotelpms an und raeumt es beim Stopp weg. Caddy muss in der
# Gruppe hotelpms sein, um den Socket zu erreichen.
RuntimeDirectory=hotelpms
RuntimeDirectoryMode=0750
# Der Socket entsteht sonst mit der Standard-Umask 022 als srwxr-xr-x, und
# die Gruppe haette nur r-x. Zum *Verbinden* mit einem Unix-Socket braucht
# man aber Schreibrecht: Caddy bekommt 502, obwohl es korrekt in der Gruppe
# hotelpms ist und das Verzeichnis betreten darf. Die Fehlersuche laeuft
# zuverlaessig in die falsche Richtung, weil alle Rechte am Verzeichnis
# stimmen. Mit 0007 entsteht er als srwxrwx---.
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# ---------------------------------------------------------------------------
# Befund S6: die Haertung war die halbe Liste.
#
# Was hier dazukommt, ist das, was ein Node-Dienst nachweislich nicht
# braucht -- kein Geraet ausser den virtuellen, keine Kernelmodule, kein
# Kernelprotokoll, keine fremden Namensraeume, keine Echtzeitprioritaet,
# keine Faehigkeiten. Jede einzelne Zeile verkleinert nicht die
# Wahrscheinlichkeit eines Einbruchs, sondern das, was danach moeglich ist.
#
# `RestrictAddressFamilies` mit AF_NETLINK, nicht ohne: `os.networkInterfaces()`
# in libuv fragt die Schnittstellenliste ueber Netlink ab, und ein Dienst,
# der daran stirbt, stirbt an einer Zeile, die niemand mit der Haertung in
# Verbindung bringt.
#
# **SystemCallFilter steht hier bewusst (noch) NICHT.** Es ist die Option mit
# dem groessten Gewinn und dem groessten Risiko: ein fehlender Aufruf endet
# als SIGSYS beim Start oder, schlimmer, Stunden spaeter unter Last. Diese
# Datei traegt mit `MemoryDenyWriteExecute` schon einen Fall, in dem genau
# das passiert ist. Sie gehoert an der Maschine mit `@system-service`
# ausprobiert und erst dann eingecheckt.
#
# Geprueft wurde hier `systemd-analyze verify` (Schreibweise, unbekannte
# Optionen). Der Startversuch auf der Maschine steht aus und gehoert zur
# naechsten Auslieferung -- so steht es auch in Dokument 21.
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
# MemoryDenyWriteExecute steht hier bewusst NICHT. Die Option verbietet
# Speicherseiten, die zugleich beschreibbar und ausfuehrbar sind -- genau
# die braucht jeder JIT-Compiler, und V8 ist einer. Der Dienst stirbt beim
# Start mit SIGTRAP im BaselineCompiler, bevor ein Socket entsteht. Es gibt
# keine vertraegliche Einstellung; --jitless waere die Alternative und
# kostet ein Vielfaches an Ausfuehrungsgeschwindigkeit. Wer sie in einem
# Drop-in abschalten muss: eine leere Zuweisung setzt sie NICHT zurueck,
# es muss =false dastehen.
# Protokoll nach journald. LogsDirectory statt ReadWritePaths, weil
# systemd das Verzeichnis dann selbst anlegt -- ein ReadWritePaths auf
# einen Pfad, den niemand anlegt, ist unter ProtectSystem=strict ein
# Startfehler.
LogsDirectory=hotelpms
# Die API bekommt keine Quote und damit Vorrang vor dem Worker.

[Install]
WantedBy=multi-user.target
