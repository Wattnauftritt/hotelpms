[Unit]
Description=hotelpms API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=hotelpms
Group=hotelpms
WorkingDirectory=/opt/hotelpms/current
EnvironmentFile=/opt/hotelpms/shared/env
Environment=NODE_ENV=production
Environment=LISTEN_SOCKET=/run/hotelpms/api.sock
ExecStart=/usr/bin/node /opt/hotelpms/current/apps/api/dist/server.js
Restart=always
RestartSec=2
# Legt /run/hotelpms an und raeumt es beim Stopp weg. Caddy muss in der
# Gruppe hotelpms sein, um den Socket zu erreichen.
RuntimeDirectory=hotelpms
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# MemoryDenyWriteExecute steht hier bewusst NICHT. Die Option verbietet
# Speicherseiten, die zugleich beschreibbar und ausfuehrbar sind -- genau
# die braucht jeder JIT-Compiler, und V8 ist einer. Der Dienst stirbt beim
# Start mit SIGTRAP im BaselineCompiler, bevor ein Socket entsteht. Es gibt
# keine vertraegliche Einstellung; --jitless waere die Alternative und
# kostet ein Vielfaches an Ausfuehrungsgeschwindigkeit. Wer sie in einem
# Drop-in abschalten muss: eine leere Zuweisung setzt sie NICHT zurueck,
# es muss =false dastehen.
# Protokoll nach journald. LogsDirectory statt ReadWritePaths, weil
# systemd das Verzeichnis dann selbst anlegt -- ein ReadWritePaths auf
# einen Pfad, den niemand anlegt, ist unter ProtectSystem=strict ein
# Startfehler.
LogsDirectory=hotelpms
# Die API bekommt keine Quote und damit Vorrang vor dem Worker.

[Install]
WantedBy=multi-user.target
