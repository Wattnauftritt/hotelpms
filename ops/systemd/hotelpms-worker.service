[Unit]
Description=hotelpms Worker
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=hotelpms
Group=hotelpms
WorkingDirectory=/opt/hotelpms/current
EnvironmentFile=/opt/hotelpms/shared/env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/hotelpms/current/apps/worker/dist/worker.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# ---------------------------------------------------------------------------
# Befund S6: die Haertung war die halbe Liste.
#
# Was hier dazukommt, ist das, was ein Node-Dienst nachweislich nicht
# braucht -- kein Geraet ausser den virtuellen, keine Kernelmodule, kein
# Kernelprotokoll, keine fremden Namensraeume, keine Echtzeitprioritaet,
# keine Faehigkeiten. Jede einzelne Zeile verkleinert nicht die
# Wahrscheinlichkeit eines Einbruchs, sondern das, was danach moeglich ist.
#
# `RestrictAddressFamilies` mit AF_NETLINK, nicht ohne: `os.networkInterfaces()`
# in libuv fragt die Schnittstellenliste ueber Netlink ab, und ein Dienst,
# der daran stirbt, stirbt an einer Zeile, die niemand mit der Haertung in
# Verbindung bringt.
#
# **SystemCallFilter steht hier bewusst (noch) NICHT.** Es ist die Option mit
# dem groessten Gewinn und dem groessten Risiko: ein fehlender Aufruf endet
# als SIGSYS beim Start oder, schlimmer, Stunden spaeter unter Last. Diese
# Datei traegt mit `MemoryDenyWriteExecute` schon einen Fall, in dem genau
# das passiert ist. Sie gehoert an der Maschine mit `@system-service`
# ausprobiert und erst dann eingecheckt.
#
# Geprueft wurde hier `systemd-analyze verify` (Schreibweise, unbekannte
# Optionen). Der Startversuch auf der Maschine steht aus und gehoert zur
# naechsten Auslieferung -- so steht es auch in Dokument 21.
PrivateDevices=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectHostname=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
# Siehe API-Unit: LogsDirectory legt das Verzeichnis selbst an.
LogsDirectory=hotelpms
# Der Worker darf die API nicht verdraengen (P5, Dokument 12).
CPUQuota=150%
MemoryMax=4G
IOWeight=50

[Install]
WantedBy=multi-user.target
