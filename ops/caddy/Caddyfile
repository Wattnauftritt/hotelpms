# Caddy holt und erneuert die Zertifikate selbst. Kein certbot, kein Cron-Job.
#
# **Diese Datei ist die laufende Fassung der Maschine, nicht ihr Entwurf.**
# Sie ist einmal auseinandergelaufen: im Repository stand eine Fassung, die
# dort nie lief, und auf der Maschine lief eine, die hier nie stand. Gemerkt
# hat es niemand, weil beide fuer sich stimmig aussahen -- genau der Schaden,
# den die Regel zu Betriebsdateien beschreibt. Wer hier etwas aendert, gleicht
# es mit `/etc/caddy/Caddyfile` ab, bevor er es einckeckt.
{
	# **Bleibt stehen, auch wenn neuere Fassungen des Moduls sich selbst
	# einordnen.** Auf dieser Maschine parst die Zeile nachweislich; sie
	# wegzulassen haenge davon ab, welche Version des Moduls dort gerade
	# installiert ist, und das ist keine Frage, deren Antwort man beim
	# Neustart des Webservers herausfinden moechte.
	order rate_limit before basicauth

	# Ohne Adresse kommt keine Warnung, wenn eine Erneuerung ausbleibt. Das
	# faellt dann am Tag des Ablaufs auf, und zwar allen gleichzeitig.
	email admin@staygrid.cloud
}

# ---------------------------------------------------------------------------
# Die Herkunft einer Anfrage -- einmal, fuer jeden Weg zur Anwendung.
#
# Caddy **ergaenzt** X-Forwarded-For normalerweise und ersetzt die Kopfzeile
# nicht: wer selbst eine mitschickt, steht danach als erster Eintrag darin.
# Zusammen mit `trustProxy: true` in der Anwendung war die Adresse, auf die
# sich die Ratenbegrenzung stuetzt, damit vom Aufrufer frei waehlbar -- eine
# Anmeldung mit einer zufaelligen Kopfzeile je Versuch kam aus einer Herkunft,
# die der Zaehler nie zweimal sah (Befund S4). Das ging ueber den regulaeren
# Weg und brauchte keinen Zugang zum Rechner.
#
# `header_up` ueberschreibt sie mit der tatsaechlichen Gegenstelle. Damit
# steht genau ein Eintrag darin, und die Anwendung vertraut genau einen Sprung
# weit. Beide Haelften gehoeren zusammen: faellt eine weg, ist die Begrenzung
# wieder zu umgehen.
# ---------------------------------------------------------------------------
(echte_herkunft) {
	header_up X-Forwarded-For {remote_host}
}

# ---------------------------------------------------------------------------
# Eine Herkunft für Oberfläche und Schnittstelle.
#
# Getrennte Namen fuer Oberfläche und Schnittstelle erzwingen CORS mit
# Anmeldedaten, `SameSite=None` am Sitzungscookie und eine gepflegte
# Liste erlaubter Herkünfte. Jede dieser drei Stellen ist eine Gelegenheit,
# sich zu vertun, und ein Fehler darin ist eine Sitzungsübernahme.
#
# Unter einer Herkunft entfällt das alles: das Cookie ist `SameSite=Lax`,
# es gibt keinen Vorabflug, keine erlaubte Herkunftsliste und keinen
# Cross-Site-Pfad, den jemand ausnutzen könnte. Der Preis ist eine
# Pfadregel in Caddy.
#
# **Zwei Namen, und der zweite ist der Umzug.** `pms.wattnauftritt.de` ist
# der Name, unter dem die Rezeption heute arbeitet. Ihn beim Umstieg auf
# StayGrid einfach zu ersetzen hiesse: wer gerade einen Check-in offen hat,
# sieht mitten darin einen Zertifikatsfehler. Beide Namen liefern dasselbe
# aus, bis niemand mehr den alten benutzt; dann faellt er weg. Das Cookie
# haengt am Namen, ein Wechsel kostet also eine Neuanmeldung -- mehr nicht.
# ---------------------------------------------------------------------------
app.staygrid.cloud, pms.wattnauftritt.de {
	encode zstd gzip

	# Erste Linie vor der Anwendung. Sie kennt selbst RATE_LIMIT_LOGIN und
	# RATE_LIMIT_ANON, aber die greifen erst, wenn die Anfrage schon einen
	# Node-Prozess beschaeftigt hat. Dokument 17 §4 verlangt beides.
	# Braucht das Modul caddy-ratelimit -- ohne es weist Caddy die
	# Konfiguration ab, statt die Begrenzung stillschweigend wegzulassen.
	#
	# **Bewusst lockerer als die Anwendung, nicht strenger.** Die steht auf 60
	# Anmeldungen je 5 Minuten, und .env.example begruendet das ausdruecklich:
	# ein Haus hat mehrere Arbeitsplaetze hinter EINER oeffentlichen Adresse,
	# und aus dem eigenen System ausgesperrt zu sein ist ein groesserer Schaden
	# als ein langsames Durchprobieren (C7, Dokument 13). Hier stand zuerst
	# 30 je 5 Minuten -- dasselbe Fenster, die halbe Grenze. Damit haette
	# Caddy immer zuerst zugeschlagen und genau das Verhalten durchgesetzt,
	# das C7 vermeiden wollte, ohne dass die Grenze der Anwendung je zum
	# Tragen gekommen waere. Auf der Maschine stand die 30 bis zuletzt.
	#
	# 300 fangen den Massenangriff ab, bevor er einen Node-Prozess
	# beschaeftigt, und lassen die fachliche Entscheidung bei der Anwendung.
	rate_limit {
		zone anmeldung {
			# Ausgeschrieben, nicht einzeilig. Ein mit { geoeffneter Block braucht
			# die schliessende Klammer auf einer eigenen Zeile; sonst weist der
			# Lexer die Datei ab: "Unexpected next token after '{' on same line".
			# Die einzeilige Form stand hier, weil sie aus Dokument 17 §4 kopiert
			# wurde -- und faellt beim Pruefen nicht auf, wenn man vorher
			# caddy fmt --overwrite laufen laesst: das bricht sie stillschweigend um.
			match {
				path /v1/auth/*
			}
			key    {remote_host}
			events 300
			window 5m
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		# Kein eval, keine fremden Herkünfte. Die Oberfläche lädt nichts
		# von außen; ein eingeschleustes Skript hat damit kein Ziel.
		#
		# Zu den Stilen (H7, Dokument 25). 'unsafe-inline' gilt nur noch für
		# **Stilattribute**, nicht mehr für eingebettete <style>-Elemente.
		# Die Attribute sind nicht wegzubekommen: der Zimmerplan setzt die
		# Balken auf gerechnete Pixel, und ein Wert je Reservierung lässt sich
		# nicht in ein Stylesheet schreiben. Ein eingeschleustes <style> ist
		# dagegen die gefährlichere Hälfte -- es kann Inhalte überlagern und
		# über Selektoren Attributwerte nach außen tragen -- und die
		# Oberfläche braucht es nirgends: der Bau erzeugt eine verlinkte
		# CSS-Datei, kein <style> im HTML, und keine Bibliothek schiebt zur
		# Laufzeit eines nach.
		#
		# `style-src` bleibt als Rückfall stehen: ein Browser, der
		# style-src-elem/-attr nicht kennt, liest ihn statt ihrer, und dann
		# soll die Oberfläche funktionieren und nicht ohne Stile dastehen.
		#
		# `frame-src https:` für die freigegebenen Adressen am Gästeterminal
		# (Dokument 31): ohne den Eintrag gilt `default-src 'self'`, und der
		# Rahmen bleibt leer. `https:` genügt, weil eine Adresse nur mit https
		# angelegt werden kann (routes/terminalInhalte.ts). Für die ganze
		# Seite, nicht nur für /terminal: ein zweiter `header` nur für diesen
		# Pfad hinge an Caddys Sortierung gleichnamiger Direktiven, und die
		# Rezeptionsoberfläche bettet selbst nichts ein. Auf der Maschine
		# so eingetragen am 04.10.2026.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-src https:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	# Die Schnittstelle unter demselben Namen. Der Unix-Socket bedeutet:
	# PostgreSQL und die Anwendung sprechen nie über TCP, und der Dienst
	# lauscht auf keinem Netzwerkport.
	#
	# Darunter auch die Zahlungsseite für Gäste (/v1/pay?t=<token>, 0068).
	# Das Token steht in der Abfragezeichenfolge, und die Anwendung ersetzt
	# deren Werte in ihrem Protokoll. **Dieser Block schreibt bewusst kein
	# Zugriffsprotokoll** (es gibt keine `log`-Direktive): Caddy schriebe die
	# volle Adresse mitsamt Token, und jeder mit Lesezugriff auf das Protokoll
	# könnte den Link bis zu seiner Frist einlösen. Wer hier ein Protokoll
	# einschaltet, filtert den Parameter t aus `request>uri` heraus (Filter
	# `query` im Format `filter`) und rechnet das an der Maschine nach --
	# hier steht bewusst keine ungeprüfte Fassung davon.
	# Referrer-Policy no-referrer oben hält das Token außerdem aus dem
	# Referer, wenn der Gast von der Seite zum Zahlungsdienstleister geht.
	handle /v1/* {
		reverse_proxy unix//run/hotelpms/api.sock {
			import echte_herkunft
		}
	}
	handle /openapi.json {
		reverse_proxy unix//run/hotelpms/api.sock {
			import echte_herkunft
		}
	}
	# /health, nicht /healthz: so heisst die Route in routes/health.ts. Stand
	# hier einmal falsch, und der Fehler war nicht "keine Antwort", sondern
	# eine falsche: /health fiel in den Oberflaechen-Zweig unten und lieferte
	# index.html mit Status 200. Wer auf den Statuscode schaut, bekam von
	# einem toten Dienst ein "gesund".
	handle /health {
		reverse_proxy unix//run/hotelpms/api.sock {
			import echte_herkunft
		}
	}

	# Alles andere ist die Oberfläche. Gebaute Dateien tragen einen Hash im
	# Namen und dürfen deshalb lange zwischengespeichert werden; index.html
	# nicht, sonst sieht die Rezeption nach einer Auslieferung noch die alte
	# Fassung und meldet Fehler, die längst behoben sind.
	#
	# `no-store` und nicht `no-cache`, und der Unterschied ist hier kein
	# Feinschliff. `no-cache` heißt "vor dem Benutzen nachfragen" und lässt
	# die Seite im Vor-Zurück-Speicher des Browsers zulässig. Nach dem
	# Abmelden baut die Anwendung die Seite neu auf (`main.tsx`), aber ein
	# Druck auf Zurück holte die alte vollständig gezeichnet wieder hervor —
	# mit denselben Gastdaten und ohne eine einzige Anfrage. Die Anwendung
	# blättert über `history.pushState`, es gibt also Einträge, auf die das
	# zuträfe. `no-store` nimmt die Seite aus diesem Speicher heraus.
	#
	# Der Preis ist ein erneuter Abruf von index.html bei jedem Zurück —
	# rund ein Kilobyte, während die gehashten Dateien daneben unberührt
	# zwischengespeichert bleiben.
	#
	# **`no-store` hängt am Pfad der Anfrage, nicht an `/index.html`.** Hier
	# stand `header /index.html ...`, und das traf nie: `header` läuft vor
	# `try_files`, sieht also den Pfad, den der Browser verlangt hat, und der
	# heißt `/` oder `/tagesgeschaeft`, nie `/index.html`. Gegen Caddy 2.10
	# nachgerechnet: `/` kam ohne jede Cache-Control-Zeile zurück. Deshalb
	# jetzt umgekehrt — `no-store` auf allem, was nicht ausdrücklich lange
	# gespeichert werden darf.
	#
	# Dazu die installierbare App (Dokument 33): `sw.js` wird bei jedem Start
	# nachgefragt, sonst bliebe ein alter Service Worker bis zu einem Tag
	# stehen; Manifest und Symbole ändern sich selten, aber ohne Hash im
	# Namen, und bekommen deshalb einen Tag. Das Manifest braucht seinen Typ
	# ausdrücklich: die Endung kennt Caddy nicht.
	handle {
		root * /opt/hotelpms/current/web
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pwa path /manifest.webmanifest /icons/*
		header @pwa Cache-Control "public, max-age=86400"
		header /manifest.webmanifest Content-Type "application/manifest+json"
		header /sw.js Cache-Control "no-cache"
		@seite not path /assets/* /manifest.webmanifest /icons/* /sw.js
		header @seite Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}

# Eigener Name für Maschinen: Channel Manager, Buchungsstrecke, Kassensysteme.
# Sie brauchen keine Oberfläche und sollen sie auch nicht sehen.
#
# Kein Gegenstueck zur Ratenbegrenzung oben: hier meldet sich kein Mensch an,
# sondern ein Client mit Client Credentials, und der holt sein Token einmal
# je Stunde. Die Anwendung begrenzt /oauth/token ohnehin selbst.
api.staygrid.cloud {
	reverse_proxy unix//run/hotelpms/api.sock {
		import echte_herkunft
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
