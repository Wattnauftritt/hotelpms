# Datenbank. Die API verbindet ueber PgBouncer, der Worker direkt (D1 in Dokument 13).
DATABASE_URL=postgres://hotelpms_app:devapp@127.0.0.1:5432/hotelpms_dev
DATABASE_URL_DIRECT=postgres://hotelpms_app:devapp@127.0.0.1:5432/hotelpms_dev
DATABASE_URL_OWNER=postgres://hotelpms_owner:devowner@127.0.0.1:5432/hotelpms_dev

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
# LISTEN_SOCKET=/run/hotelpms/api.sock

# Mindestens 32 Zeichen. Kein stiller Standardwert, der Start bricht sonst ab.
SESSION_SECRET=entwicklung-nur-bitte-in-produktion-ersetzen-0001
ID_DOCUMENT_KEY=entwicklung-nur-bitte-in-produktion-ersetzen-0002

# Ratenbegrenzung. Bewusst hoch: ein Haus hat mehrere Arbeitsplaetze hinter
# einer oeffentlichen Adresse, und aus dem eigenen System ausgesperrt zu sein
# ist ein groesserer Schaden als ein langsames Durchprobieren (C7).
# RATE_LIMIT_LOGIN=60
# RATE_LIMIT_ANON=300

# Nur waehrend einer Schluesselrotation gesetzt, siehe docs/17-betrieb.md.
# Beide Schluessel muessen gleichzeitig bekannt sein: der alte zum Lesen,
# der neue zum Schreiben.
# ID_DOCUMENT_KEY_OLD=
# ID_DOCUMENT_KEY_VERSION=2

# Ziel fuer Erfolgs- und Abbruchseite nach Pay-by-Link. Keine geheime Angabe.
PUBLIC_APP_URL=http://localhost:5173

# Payment-Adapter (Aufgabe 6). Optional: ohne diese beiden meldet die
# betroffene Route 503, der Rest des Systems laeuft unveraendert.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Mailversand ueber die REST-API von Brevo (nicht SMTP). Optional: ohne
# Schluessel bleibt eingereihte Gastpost in der Warteschlange stehen und geht
# hinaus, sobald er da ist. Der Absender muss bei Brevo verifiziert sein;
# eingetragen wird er je Haus unter /v1/properties/:id/email-settings.
# BREVO_API_KEY=xkeysib-...
