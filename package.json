{
  "name": "hotelpms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "_pnpm_overrides": "Geflickte Fassungen erzwingen, wo die Abhaengigkeit sie nicht selbst mitbringt (Befund S3). brace-expansion steckt unter eslint und eslint-plugin-import-x in minimatch, zwei Ebenen tief; ohne diese beiden Zeilen faellt `pnpm audit --audit-level high` in CI. Beide bleiben innerhalb ihrer Hauptversion, damit minimatch 3 und minimatch 10 ihre jeweilige Schnittstelle behalten.",
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=4.0.0 <5.0.10": "^5.0.10"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "pnpm --filter @hotelpms/db migrate",
    "db:reset": "pnpm --filter @hotelpms/db reset",
    "db:seed": "pnpm --filter @hotelpms/db seed",
    "db:testhotel": "pnpm --filter @hotelpms/db testhotel",
    "db:plattformbenutzer": "pnpm --filter @hotelpms/db plattformbenutzer",
    "dev:api": "pnpm --filter @hotelpms/api dev",
    "dev:web": "pnpm --filter @hotelpms/web dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-import-x": "^4.6.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  }
}
